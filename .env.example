# ==============================================================================
# CORALIS-PS Operational CRM & Telemetry Service
# Environment Configuration Template
# Instructions: Copy this file to .env and configure your real credentials.
# ==============================================================================

# Database Connection (PostgreSQL with isolated schema)
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_db
DB_SCHEMA=portfolio
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# API Service Configuration
API_HOST=0.0.0.0
API_PORT=8020

# Integration & Inbound Security Keys
N8N_API_KEY=your_n8n_inbound_api_key_here
JWT_SECRET=your_jwt_secret_key_change_in_production

# LinkedIn Social Publisher API (Optional)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PERSON_URN=
